# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: custom Solana devnet RPC
# SOLANA_RPC=https://api.devnet.solana.com

# OpenRouter key (openrouter.ai/keys). Free models are used by default.
OPENROUTER_API_KEY=
# Optional: comma-separated model list, tried in order
# OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,baidu/ernie-5.5-flash-preview:free
